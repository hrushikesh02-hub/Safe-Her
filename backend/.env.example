PORT=5000

# MongoDB Connection String (e.g. MongoDB Atlas connection URL)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/safeher?retryWrites=true&w=majority

# Security
JWT_SECRET=your_jwt_super_secret_key_here

# Third-party Integrations
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Brevo (formerly Sendinblue) Email API
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_verified_sender_email@domain.com
BREVO_SENDER_NAME=SafeHer Emergency System

# AI Microservice URL (e.g. Render Web Service URL for ai-service)
AI_SERVICE_URL=https://safeher-ai-service.onrender.com

# Phase 1 — Voice SOS Thresholds
VOICE_CRITICAL_THRESHOLD=76
REPEATED_DISTRESS_COUNT=2
REPEATED_DISTRESS_WINDOW=30

# Phase 2 — Movement + Fusion Thresholds
MOVEMENT_CRITICAL_THRESHOLD=70
FUSION_AUTO_SOS_THRESHOLD=78

# Phase 2 — Fusion weights (must sum to 1.0)
VOICE_WEIGHT=0.5
MOVEMENT_WEIGHT=0.3
GPS_CONTEXT_WEIGHT=0.2

# Volunteer proximity search radius (km)
VOLUNTEER_RADIUS_KM=5
